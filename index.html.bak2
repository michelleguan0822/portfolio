<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ALEX.DESIGN | Chaos Navigator</title>
    <link
        href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;700&family=JetBrains+Mono:wght@400;700&display=swap"
        rel="stylesheet">
    <link rel="stylesheet" href="styles.css">
    <!-- Lucide Icons -->
    <script src="https://unpkg.com/lucide@latest"></script>
</head>

<body>

    <!-- Global Noise Background -->
    <div class="noise-overlay"></div>

    <!-- Ambient Glow -->
    <div class="ambient-glow"></div>

    <!-- 1. LOADING SCREEN -->
    <div id="loading-screen" class="loading-screen">
        <div class="loader-content">
            <div class="loader-meta">
                <span>Sys.Boot</span>
                <span id="boot-percent">0%</span>
            </div>

            <div class="loader-track">
                <div id="loader-bar" class="loader-bar"></div>
                <div id="loader-glitch" class="loader-glitch"></div>
            </div>

            <div class="loader-log">
                <p id="boot-text" class="animate-pulse">INITIALIZING KERNEL...</p>
            </div>
        </div>
    </div>

    <!-- 2. MAIN INTERFACE -->
    <div id="main-interface" class="main-interface hidden">

        <!-- Hero Header -->
        <header class="hero">
            <div class="hero-text">
                <h1 class="hero-title">ALEX.DESIGN</h1>
                <p class="hero-subtitle">Chaos Navigator / Digital Craftsman</p>
            </div>
            <button id="btn-profile" class="btn-profile group">
                <span class="status-dot"></span>
                Profile
            </button>
        </header>

        <!-- Work Deck (Cards Container) -->
        <div id="work-deck" class="work-deck">
            <div class="deck-hint">SYSTEM READY // DRAG TO DECODE</div>
            <!-- Cards injected by JS -->
        </div>

        <!-- Reader Unit (Bottom Center) -->
        <div id="reader-unit" class="reader-unit">
            <div class="reader-beam"></div>
            <div class="reader-back"></div>
            <div class="reader-slot"></div>
            <div class="reader-front">
                <div class="reader-texture"></div>
                <div class="reader-logo">
                    <i data-lucide="scan"></i>
                </div>
                <div class="reader-status">
                    <i data-lucide="sparkles" class="status-icon left"></i>
                    <span id="reader-text">INSERT CARD</span>
                    <i data-lucide="sparkles" class="status-icon right"></i>
                </div>
            </div>
        </div>

    </div>

    <!-- 3. PROJECT MODAL -->
    <div id="project-modal" class="modal-backdrop hidden">
        <div class="modal-card">
            <button id="btn-close-modal" class="btn-close">
                <i data-lucide="x"></i>
            </button>

            <div id="modal-visual" class="modal-visual">
                <h2 id="modal-title">Project Title</h2>
            </div>

            <div class="modal-content">
                <div class="modal-meta">
                    <span id="modal-category" class="tag">UI/UX</span>
                    <span id="modal-id" class="case-id">CASE #001</span>
                </div>

                <h3 class="section-title">Brief</h3>
                <p id="modal-desc" class="modal-body">Description...</p>

                <div class="modal-footer">
                    <h4 class="section-subtitle">Deliverables</h4>
                    <ul class="deliverables-list">
                        <li><span class="dot"></span>UI Design</li>
                        <li><span class="dot"></span>Design System</li>
                        <li><span class="dot"></span>Prototyping</li>
                        <li><span class="dot"></span>User Research</li>
                    </ul>

                    <button class="btn-link">
                        View Live Prototype <i data-lucide="arrow-right"></i>
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- 4. ABOUT DRAWER -->
    <aside id="about-drawer" class="drawer-backdrop hidden">
        <div class="drawer-panel">
            <div class="drawer-header">
                <h2>Profile.</h2>
                <button id="btn-close-drawer" class="btn-icon">
                    <i data-lucide="x"></i>
                </button>
            </div>

            <div class="drawer-body">
                <section>
                    <h3>Bio</h3>
                    <p>Digital product designer obsessed with the intersection of chaos and order. I build systems that
                        feel organic and interactions that feel physical.</p>
                </section>

                <section>
                    <h3>Connect</h3>
                    <nav class="connect-links">
                        <a href="mailto:hello@alex.design" class="connect-item">
                            <i data-lucide="mail"></i> hello@alex.design
                        </a>
                        <a href="#" class="connect-item">
                            <i data-lucide="linkedin"></i> LinkedIn
                        </a>
                        <a href="#" class="connect-item">
                            <i data-lucide="github"></i> GitHub
                        </a>
                    </nav>
                </section>

                <section>
                    <h3>Resume</h3>
                    <a href="#" class="resume-card">
                        <div class="row">
                            <i data-lucide="file-text"></i>
                            <span>Download CV (PDF)</span>
                        </div>
                        <i data-lucide="arrow-right"></i>
                    </a>
                </section>
            </div>

            <div class="drawer-footer">
                SYSTEM STATUS: ONLINE <br> LATENCY: 12ms
            </div>
        </div>
    </aside>

    <script src="js/app.js"></script>
</body>

</html>