<!DOCTYPE html>
<html lang="zh">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>About Me - Michelle's UX Studio</title>
  <link
    href="https://fonts.googleapis.com/css2?family=Press+Start+2P&family=Space+Grotesk:wght@300;500;700&display=swap"
    rel="stylesheet">

  <style>
    :root {
      --primary: #c3ff00;
      /* 赛博荧光绿 */
      --secondary: #7000ff;
      /* 深度紫 */
      --danger: #ff0055;
      /* Bug 红色 */
      --bg: #050505;
      --surface: #121212;
      --border: #222;
      --text-main: #ffffff;
      --text-dim: #888;
    }

    /* God Mode Variables */
    body.god-mode {
      --primary: #ff0055;
      --secondary: #00ffff;
      --bg: #1a0005;
    }

    html {
      scroll-behavior: smooth;
    }

    /* ---------------- NEW: HERO SPECIFIC STYLES ---------------- */
    /* Hacker Text Effect */
    .hacker-text {
      display: inline-block;
      cursor: default;
    }

    .hacker-text:hover {
      color: var(--primary);
      text-shadow: 2px 0 var(--secondary);
    }

    /* Status Bars (HP/MP) */
    .status-bars {
      margin-top: 20px;
      margin-bottom: 30px;
      font-family: 'Press Start 2P';
      font-size: 10px;
      width: 100%;
      max-width: 300px;
    }

    .bar-row {
      display: flex;
      align-items: center;
      gap: 10px;
      margin-bottom: 8px;
    }

    .bar-label {
      width: 40px;
      color: var(--text-dim);
    }

    .bar-track {
      flex: 1;
      height: 12px;
      background: rgba(255, 255, 255, 0.1);
      border: 1px solid rgba(255, 255, 255, 0.2);
      border-radius: 2px;
      overflow: hidden;
      position: relative;
    }

    .bar-fill {
      height: 100%;
      width: 100%;
      transition: width 0.5s ease-out;
      position: relative;
    }

    /* HP - Red/Pink */
    .hp-fill {
      background: var(--danger);
      width: 85%;
    }

    /* MP - Blue/Cyan */
    .mp-fill {
      background: #00e5ff;
      width: 40%;
      animation: pulse-bar 2s infinite;
    }

    @keyframes pulse-bar {
      0% {
        opacity: 0.8;
      }

      50% {
        opacity: 1;
        box-shadow: 0 0 10px #00e5ff;
      }

      100% {
        opacity: 0.8;
      }
    }

    /* Shake Animation for Avatar */
    .shake {
      animation: shake 0.3s cubic-bezier(.36, .07, .19, .97) both;
    }

    @keyframes shake {

      10%,
      90% {
        transform: translate3d(-1px, 0, 0);
      }

      20%,
      80% {
        transform: translate3d(2px, 0, 0);
      }

      30%,
      50%,
      70% {
        transform: translate3d(-4px, 0, 0);
      }

      40%,
      60% {
        transform: translate3d(4px, 0, 0);
      }
    }

    /* Floating Icons */
    .float-icon {
      position: absolute;
      font-size: 20px;
      pointer-events: none;
      animation: popUpFade 1s forwards;
      z-index: 20;
    }

    @keyframes popUpFade {
      0% {
        transform: translate(-50%, -50%) scale(0.5);
        opacity: 0;
      }

      20% {
        transform: translate(-50%, -100%) scale(1.2);
        opacity: 1;
      }

      100% {
        transform: translate(-50%, -200%) scale(1);
        opacity: 0;
      }
    }

    /* ----------------------------------------------------------- */

    * {
      box-sizing: border-box;
    }

    a,
    button,
    .panel,
    .skill-tag,
    input {
      transition: 0.25s cubic-bezier(0.4, 0, 0.2, 1);
    }

    body {
      background-color: var(--bg);
      color: var(--text-main);
      margin: 0;
      font-family: 'Space Grotesk', sans-serif;
      line-height: 1.6;
      overflow-x: hidden;
      cursor: default;
    }

    /* ---------------- 顶部进度条 ---------------- */
    .scroll-progress {
      position: fixed;
      top: 0;
      left: 0;
      height: 4px;
      width: 100%;
      background: var(--secondary);
      z-index: 1000;
      transform-origin: left center;
      transform: scaleX(0);
      will-change: transform;
    }

    /* 像素漂浮物背景 + 鼠标拖尾 */
    .pixel-bg-elements {
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      pointer-events: none;
      z-index: -1;
      opacity: 0.3;
    }

    /* ---------------- NAV (Shared Style) ---------------- */
    .nav-shell {
      position: sticky;
      top: 14px;
      z-index: 950;
      display: flex;
      justify-content: center;
      padding: 10px 16px;
      will-change: transform;
      transform: translateZ(0);
    }

    .nav-inner {
      display: flex;
      align-items: center;
      gap: 14px;
      padding: 10px 16px;
      border-radius: 999px;
      position: relative;
      overflow: hidden;
      background: linear-gradient(180deg, rgba(255, 255, 255, 0.10), rgba(255, 255, 255, 0.06));
      border: 1px solid rgba(255, 255, 255, 0.10);
      backdrop-filter: blur(10px);
      box-shadow: 0 10px 40px rgba(0, 0, 0, 0.35);
    }

    .nav-inner::after {
      content: "";
      position: absolute;
      inset: -1px;
      background:
        radial-gradient(280px 160px at 20% 30%, rgba(195, 255, 0, 0.12), transparent 60%),
        radial-gradient(260px 160px at 80% 70%, rgba(112, 0, 255, 0.14), transparent 58%);
      opacity: 0.9;
      pointer-events: none;
      filter: blur(0.2px);
      mix-blend-mode: screen;
    }

    .nav-inner a {
      font-family: 'Press Start 2P';
      font-size: 10px;
      color: rgba(255, 255, 255, 0.86);
      letter-spacing: .3px;
      padding: 6px 10px;
      border-radius: 10px;
      position: relative;
      z-index: 2;
      opacity: .92;
      text-decoration: none;
    }

    .nav-inner a:hover {
      opacity: 1;
      color: #fff;
      background: rgba(255, 255, 255, 0.06);
      box-shadow: 0 0 16px rgba(195, 255, 0, 0.12);
    }

    .nav-inner a.active {
      opacity: 1;
      color: #0b0b0b;
      background: var(--primary);
      box-shadow: 0 0 0 1px rgba(0, 0, 0, 0.35) inset, 0 12px 26px rgba(195, 255, 0, 0.15);
    }

    /* ---------------- About Page Specifics ---------------- */
    .container {
      max-width: 1000px;
      margin: 0 auto;
      padding: 0 20px;
    }

    .intro-section {
      padding: 120px 0 80px;
      display: grid;
      grid-template-columns: 1.2fr 0.8fr;
      gap: 60px;
      align-items: start;
    }

    .glitch-text {
      font-size: clamp(48px, 6vw, 80px);
      font-weight: 700;
      line-height: 0.9;
      letter-spacing: -3px;
      margin: 0 0 30px;
      position: relative;
    }

    .cursor::after {
      content: '▋';
      display: inline-block;
      margin-left: 5px;
      color: var(--primary);
      animation: blink 1s step-end infinite;
    }

    @keyframes blink {
      50% {
        opacity: 0;
      }
    }

    .highlight {
      color: var(--primary);
    }

    .intro-bio {
      font-size: 20px;
      color: var(--text-dim);
      max-width: 500px;
      margin-bottom: 40px;
      min-height: 100px;
    }

    .stats-row {
      display: flex;
      gap: 30px;
      margin-top: 20px;
      font-family: 'Press Start 2P';
      font-size: 10px;
      color: rgba(255, 255, 255, 0.6);
    }

    .stats-row div b {
      display: block;
      font-size: 24px;
      color: var(--text-main);
      margin-bottom: 8px;
      font-family: 'Space Grotesk';
    }

    /* GAME BUTTON (Used inside section now) */
    .game-btn {
      display: inline-flex;
      align-items: center;
      gap: 10px;
      padding: 16px 24px;
      background: rgba(195, 255, 0, 0.1);
      border: 1px solid var(--primary);
      color: var(--primary);
      font-family: 'Press Start 2P';
      font-size: 12px;
      cursor: pointer;
      text-transform: uppercase;
    }

    .game-btn:hover {
      background: var(--primary);
      color: #000;
      box-shadow: 0 0 20px rgba(195, 255, 0, 0.4);
    }

    /* Avatar Frame */
    .avatar-frame {
      position: relative;
      width: 100%;
      aspect-ratio: 0.8;
      border-radius: 200px 200px 20px 20px;
      overflow: hidden;
      border: 1px solid rgba(255, 255, 255, 0.1);
      background: #111;
      cursor: crosshair;
      transition: transform 0.1s;
    }

    .avatar-frame:active {
      transform: scale(0.98);
      border-color: var(--primary);
    }

    .avatar-frame::before {
      content: "";
      position: absolute;
      inset: 0;
      background:
        linear-gradient(180deg, rgba(195, 255, 0, 0.05), transparent 60%),
        repeating-linear-gradient(0deg, transparent, transparent 2px, rgba(0, 0, 0, 0.5) 3px);
      pointer-events: none;
      z-index: 2;
    }

    .avatar-placeholder {
      width: 100%;
      height: 100%;
      background: url('https://placehold.co/600x800/1a1a1a/FFF?text=CLICK_ME') center/cover;
      opacity: 0.8;
      filter: grayscale(100%) contrast(1.2);
      transition: 0.5s;
    }

    .avatar-frame:hover .avatar-placeholder {
      filter: grayscale(0%) contrast(1);
    }

    .xp-float {
      position: absolute;
      color: var(--primary);
      font-family: 'Press Start 2P';
      font-size: 12px;
      pointer-events: none;
      animation: floatUp 1s ease-out forwards;
      z-index: 10;
    }

    @keyframes floatUp {
      0% {
        opacity: 1;
        transform: translateY(0) scale(1);
      }

      100% {
        opacity: 0;
        transform: translateY(-50px) scale(1.5);
      }
    }

    /* Sections */
    .section-title {
      font-family: 'Press Start 2P';
      font-size: 14px;
      color: var(--secondary);
      margin-bottom: 30px;
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .section-title::after {
      content: "";
      height: 1px;
      flex: 1;
      background: rgba(255, 255, 255, 0.1);
    }

    .grid-2 {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 20px;
      margin-bottom: 80px;
    }

    .panel {
      background: rgba(255, 255, 255, 0.03);
      border: 1px solid rgba(255, 255, 255, 0.08);
      border-radius: 20px;
      padding: 24px;
      position: relative;
      overflow: hidden;
    }

    .panel:hover {
      border-color: rgba(195, 255, 0, 0.4);
      background: rgba(255, 255, 255, 0.05);
      transform: translateY(-2px);
    }

    .exp-date {
      font-family: 'Press Start 2P';
      font-size: 10px;
      color: var(--text-dim);
      margin-bottom: 8px;
      display: block;
    }

    .exp-role {
      font-size: 22px;
      font-weight: 700;
      margin: 0 0 4px;
    }

    .exp-company {
      font-size: 16px;
      color: var(--primary);
      margin-bottom: 12px;
    }

    .skills-wrapper {
      display: flex;
      flex-wrap: wrap;
      gap: 12px;
      margin-bottom: 80px;
    }

    .skill-tag {
      padding: 10px 16px;
      border: 1px solid rgba(255, 255, 255, 0.15);
      border-radius: 8px;
      font-family: 'Press Start 2P';
      font-size: 10px;
      color: rgba(255, 255, 255, 0.8);
      cursor: pointer;
      user-select: none;
    }

    .skill-tag:hover {
      border-color: var(--primary);
      color: var(--primary);
      box-shadow: 0 0 15px rgba(195, 255, 0, 0.2);
      transform: translateY(-2px);
    }

    .skill-tag.equipped {
      background: var(--primary);
      color: #000;
      border-color: var(--primary);
      box-shadow: 0 0 20px rgba(195, 255, 0, 0.4);
    }

    .contact-footer {
      border-top: 1px solid var(--border);
      padding: 80px 0;
      text-align: center;
    }

    .contact-link {
      display: inline-block;
      font-size: 40px;
      font-weight: 700;
      color: #fff;
      text-decoration: none;
      margin-top: 20px;
      border-bottom: 2px solid var(--primary);
    }

    .contact-link:hover {
      color: var(--primary);
    }

    .system-log {
      position: fixed;
      bottom: 20px;
      right: 20px;
      font-family: 'Press Start 2P';
      font-size: 10px;
      color: var(--primary);
      background: rgba(0, 0, 0, 0.8);
      border: 1px solid var(--primary);
      padding: 10px 15px;
      z-index: 2000;
      display: none;
      pointer-events: none;
    }

    .terminal-wrapper {
      position: fixed;
      bottom: 20px;
      left: 20px;
      z-index: 1001;
      display: flex;
      align-items: center;
      gap: 10px;
      background: rgba(0, 0, 0, 0.7);
      backdrop-filter: blur(5px);
      padding: 5px 10px;
      border-radius: 8px;
      border: 1px solid rgba(255, 255, 255, 0.1);
      transition: opacity 0.3s;
    }

    .terminal-wrapper:hover,
    .terminal-wrapper:focus-within {
      border-color: var(--primary);
      opacity: 1;
    }

    .terminal-prompt {
      font-family: 'Press Start 2P';
      font-size: 12px;
      color: var(--primary);
    }

    #cmd-input {
      background: transparent;
      border: none;
      outline: none;
      font-family: 'Space Grotesk', monospace;
      color: var(--text-main);
      font-size: 14px;
      width: 150px;
    }

    #cmd-input::placeholder {
      color: rgba(255, 255, 255, 0.2);
    }

    /* --- 3D BOOK STYLES (New!) --- */
    .book-scene {
      width: 100%;
      max-width: 600px;
      height: 420px;
      margin: 0 auto 80px;
      perspective: 1500px;
      position: relative;
    }

    .book {
      width: 100%;
      height: 100%;
      position: relative;
      transform-style: preserve-3d;
    }

    .page {
      position: absolute;
      width: 50%;
      height: 100%;
      top: 0;
      right: 0;
      transform-origin: left center;
      transition: transform 0.8s cubic-bezier(0.645, 0.045, 0.355, 1);
      transform-style: preserve-3d;
      cursor: pointer;
      z-index: 1;
    }

    .page-face {
      position: absolute;
      width: 100%;
      height: 100%;
      backface-visibility: hidden;
      display: flex;
      flex-direction: column;
      padding: 30px;
      background: #1a1a1d;
      border: 1px solid rgba(255, 255, 255, 0.1);
      box-shadow: inset 0 0 30px rgba(0, 0, 0, 0.5);
      /* Paper Lines */
      background-image: linear-gradient(rgba(255, 255, 255, 0.05) 1px, transparent 1px);
      background-size: 100% 30px;
    }

    .page-face.front {
      border-right: 4px solid var(--secondary);
      /* Spine hint */
    }

    .page-face.back {
      transform: rotateY(180deg);
      background: #111;
      border-left: 1px solid rgba(255, 255, 255, 0.1);
      /* Grid Pattern for back */
      background-image:
        linear-gradient(rgba(255, 255, 255, 0.03) 1px, transparent 1px),
        linear-gradient(90deg, rgba(255, 255, 255, 0.03) 1px, transparent 1px);
      background-size: 20px 20px;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    /* Page Flipped State */
    .page.flipped {
      transform: rotateY(-180deg);
    }

    /* Z-Index Stacking: Newest page on top */
    .page:nth-child(1) {
      z-index: 5;
    }

    .page:nth-child(2) {
      z-index: 4;
    }

    .page:nth-child(3) {
      z-index: 3;
    }

    .page:nth-child(4) {
      z-index: 2;
    }

    .page:nth-child(5) {
      z-index: 1;
    }

    /* Content Styling inside Page */
    .log-header {
      display: flex;
      justify-content: space-between;
      border-bottom: 2px solid var(--primary);
      padding-bottom: 10px;
      margin-bottom: 20px;
      font-family: 'Press Start 2P';
      font-size: 10px;
      color: var(--primary);
    }

    .log-body {
      font-size: 14px;
      line-height: 1.8;
      color: rgba(255, 255, 255, 0.9);
    }

    .log-code {
      font-family: 'Space Grotesk', monospace;
      color: var(--text-dim);
      font-size: 12px;
      margin-top: 15px;
      display: block;
      font-style: italic;
    }

    .tap-hint {
      position: absolute;
      bottom: 20px;
      right: 20px;
      font-family: 'Press Start 2P';
      font-size: 10px;
      color: #fff;
      animation: blink 1s infinite;
    }

    /* Mobile adjustments for Book */
    @media (max-width: 600px) {
      .book-scene {
        width: 90%;
        height: 500px;
      }

      /* On mobile, standard flipping might be too small, but keeping it for effect */
      .page-face {
        padding: 15px;
      }

      .log-body {
        font-size: 12px;
      }
    }

    /* --- GAME STYLES --- */
    .game-section-wrapper {
      background: rgba(255, 255, 255, 0.03);
      border: 1px solid rgba(255, 255, 255, 0.08);
      border-radius: 20px;
      padding: 30px;
      display: flex;
      flex-direction: column;
      align-items: center;
      position: relative;
      margin-bottom: 80px;
    }

    .game-board-container {
      position: relative;
      border: 2px solid #333;
      box-shadow: 0 0 30px rgba(0, 0, 0, 0.5);
      cursor: none;
      /* Hide default cursor inside game */
    }

    canvas#game-board {
      background: #000;
      /* Dark for Hide & Seek */
      display: block;
      width: 100%;
      max-width: 400px;
      height: auto;
      aspect-ratio: 1;
    }

    .game-ui-bar {
      width: 100%;
      max-width: 400px;
      display: flex;
      justify-content: space-between;
      margin-bottom: 14px;
      font-family: 'Press Start 2P';
      font-size: 12px;
      color: #fff;
    }

    .mobile-controls {
      margin-top: 15px;
      font-family: 'Press Start 2P';
      font-size: 10px;
      color: #666;
      display: none;
      text-align: center;
    }

    @media (hover: none) and (pointer: coarse) {
      .mobile-controls {
        display: block;
      }

      /* Show cursor on touch devices */
      .game-board-container {
        cursor: auto;
      }
    }

    /* Result Card (Overlay on canvas) */
    .game-result-card {
      position: absolute;
      inset: 0;
      background: rgba(0, 0, 0, 0.9);
      display: none;
      /* Flex when active */
      flex-direction: column;
      align-items: center;
      justify-content: center;
      text-align: center;
      z-index: 10;
      backdrop-filter: blur(2px);
      cursor: default;
    }

    /* Start Overlay (Overlay on canvas) */
    .game-start-overlay {
      position: absolute;
      inset: 0;
      background: rgba(0, 0, 0, 0.6);
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      text-align: center;
      z-index: 5;
      cursor: default;
    }

    @media (max-width: 800px) {
      .intro-section {
        grid-template-columns: 1fr;
        gap: 40px;
      }

      .avatar-frame {
        width: 80%;
        margin: 0 auto;
        aspect-ratio: 1;
        border-radius: 50%;
      }

      .grid-2 {
        grid-template-columns: 1fr;
      }

      .glitch-text {
        font-size: 42px;
      }

      .terminal-wrapper {
        display: none;
      }
    }
  </style>
</head>

<body>

  <div class="scroll-progress" id="bar"></div>
  <canvas class="pixel-bg-elements" id="canvas"></canvas>

  <div id="sys-log" class="system-log">SYSTEM: Welcome, Player 1.</div>

  <div class="terminal-wrapper" title="Try: /help, /coffee, /contact">
    <span class="terminal-prompt">&gt;_</span>
    <input type="text" id="cmd-input" placeholder="Type /help..." autocomplete="off">
  </div>

  <header class="nav-shell">
    <nav class="nav-inner">
      <a href="index.html" class="sfx-hover">Home</a>
      <a class="active sfx-hover" href="about-me.html">About Me</a>
      <a href="resume.pdf" class="sfx-hover" target="_blank">Resume</a>
      <a href="mailto:hello@example.com" class="sfx-hover">Contact Me</a>
    </nav>
  </header>

  <main class="container">

    <section class="intro-section">
      <div>
        <div class="section-title">00_PLAYER_SELECT</div>

        <!-- UPDATED H1 with Hacker Text -->
        <h1 class="glitch-text" style="font-size: clamp(40px, 5vw, 72px);">
          <span class="hacker-text" data-value="DESIGNER">DESIGNER</span><br>
          <span class="hacker-text" data-value="BUILDER">BUILDER</span><br>
          <span class="hacker-text highlight" data-value="HUMANIST">HUMANIST</span>
        </h1>

        <!-- NEW: HP/MP Status Bars -->
        <div class="status-bars">
          <div class="bar-row">
            <span class="bar-label">HP</span>
            <div class="bar-track" title="Caffeine Level">
              <div class="bar-fill hp-fill" id="hp-bar"></div>
            </div>
            <span style="font-size:10px; color:var(--danger)">100%</span>
          </div>
          <div class="bar-row">
            <span class="bar-label">MP</span>
            <div class="bar-track" title="Creativity">
              <div class="bar-fill mp-fill" id="mp-bar"></div>
            </div>
            <span style="font-size:10px; color:#00e5ff">REGEN</span>
          </div>
        </div>

        <p class="intro-bio" id="bio-text"></p>

        <div class="stats-row">
          <div><b>4+</b>YRS EXP</div>
          <div><b>12</b>QUESTS</div>
          <div><b id="coffee-counter">8842</b>COFFEE</div>
        </div>
      </div>

      <div class="avatar-frame sfx-click" id="avatar-clicker" title="Click to Loot">
        <div class="avatar-placeholder"></div>
        <div
          style="position: absolute; bottom: 20px; right: 20px; font-family: 'Press Start 2P'; font-size: 10px; color: var(--primary); background:rgba(0,0,0,0.7); padding:4px 8px; border-radius:4px; border:1px solid var(--primary);">
          LVL. <span id="level-display">25</span>
        </div>
      </div>
    </section>

    <!-- NEW: 3D FLIP BOOK LOG -->
    <div class="section-title">01_ORIGIN_LOG (FLIP TO READ)</div>
    <div class="book-scene">
      <div class="book">

        <!-- Cover Page (Top) -->
        <div class="page" onclick="flipPage(this)">
          <div class="page-face front" style="justify-content:center; align-items:center; text-align:center;">
            <h2 style="font-family:'Press Start 2P'; color:var(--primary); line-height:1.5;">ENCRYPTED<br>LOG<br>V1.0
            </h2>
            <p style="color:#aaa; margin-top:20px; font-size:12px;">Michelle's Origin Story</p>
            <div class="tap-hint">TAP TO OPEN &gt;</div>
          </div>
          <div class="page-face back">
            <div style="font-family:'Press Start 2P'; font-size:10px; color:#333;">LOADING ARCHIVE...</div>
          </div>
        </div>

        <!-- Page 1 -->
        <div class="page" onclick="flipPage(this)">
          <div class="page-face front">
            <div class="log-header">
              <span>ENTRY #001</span>
              <span>2016</span>
            </div>
            <div class="log-body">
              Started as a CS student. Code compiled successfully, but the UI looked terrible and I couldn't sleep
              because of it.
            </div>
            <span class="log-code">// SYSTEM_ALERT: Realized I care more about humans than algorithms.</span>
            <div class="tap-hint" style="bottom:10px; right:10px;">NEXT &gt;</div>
          </div>
          <div class="page-face back"></div>
        </div>

        <!-- Page 2 -->
        <div class="page" onclick="flipPage(this)">
          <div class="page-face front">
            <div class="log-header">
              <span>ENTRY #002</span>
              <span>2018</span>
            </div>
            <div class="log-body">
              <span style="color:var(--primary)">CLASS CHANGE INITIATED.</span> Self-taught Figma at night. Read "The
              Design of Everyday Things" until the pages fell out.
            </div>
            <span class="log-code">// GRINDING: 3AM coffee became my best friend.</span>
            <div class="tap-hint" style="bottom:10px; right:10px;">NEXT &gt;</div>
          </div>
          <div class="page-face back"></div>
        </div>

        <!-- Page 3 -->
        <div class="page" onclick="flipPage(this)">
          <div class="page-face front">
            <div class="log-header">
              <span>ENTRY #003</span>
              <span>2021</span>
            </div>
            <div class="log-body">
              Joined <b>StartUp Inc.</b> as the first designer. Built the entire design system from chaos.
            </div>
            <span class="log-code">// LEVEL UP: Learned that design is not just art, it's problem solving.</span>
            <div class="tap-hint" style="bottom:10px; right:10px;">NEXT &gt;</div>
          </div>
          <div class="page-face back"></div>
        </div>

        <!-- Page 4 (Bottom) -->
        <div class="page" onclick="flipPage(this)">
          <div class="page-face front">
            <div class="log-header">
              <span>ENTRY #004</span>
              <span>NOW</span>
            </div>
            <div class="log-body">
              Leading design at <b>Tech Giant</b>. Focusing on gamification and emotional design.
            </div>
            <span class="log-code">// CURRENT OBJECTIVE: Make software feel like a game.</span>
            <div style="margin-top:auto; text-align:center;">
              <span style="font-family:'Press Start 2P'; font-size:10px; color:#444;">[END OF LOG]</span>
            </div>
          </div>
          <div class="page-face back"></div>
        </div>

      </div>
    </div>

    <!-- REPLACED: EQUIPMENT_LOADOUT -> TECH_ARSENAL -->
    <div class="section-title">02_TECH_ARSENAL</div>
    <p style="font-size: 12px; color: var(--text-dim); margin-bottom: 15px;">[SYSTEM] Click modules to
      activate/overclock.</p>
    <div class="skills-wrapper" id="skill-tree">
      <div class="skill-tag sfx-click">FIGMA</div>
      <div class="skill-tag sfx-click">PROTOTYPING</div>
      <div class="skill-tag sfx-click">SYSTEM DESIGN</div>
      <div class="skill-tag sfx-click">USER RESEARCH</div>
      <div class="skill-tag sfx-click">HTML/CSS</div>
      <div class="skill-tag sfx-click">MOTION</div>
      <div class="skill-tag sfx-click">DATA VIZ</div>
      <div class="skill-tag sfx-click" style="border-color: var(--secondary); color: var(--secondary)">GAMIFICATION
      </div>
      <div class="skill-tag sfx-click" style="border-color: var(--primary); color: var(--primary)">STRATEGY</div>
    </div>

    <!-- NEW INLINE GAME SECTION: HIDE & SEEK -->
    <div class="section-title">03_SIDE_QUEST: HIDE & SEEK</div>
    <div class="game-section-wrapper">

      <div class="game-ui-bar">
        <div>STATUS: <span id="seek-status" style="color:var(--primary)">WAITING...</span></div>
        <div>TIME ELAPSED: <span id="seek-timer" style="color:#888">0.0</span>s</div>
      </div>

      <div class="game-board-container" id="game-container">
        <canvas id="game-board" width="400" height="400"></canvas>

        <!-- Start Overlay -->
        <div id="game-start-screen" class="game-start-overlay">
          <p style="font-family:'Press Start 2P'; color:#fff; font-size:12px; margin-bottom:20px;">FIND THE GLITCH CAT
            🐱</p>
          <button id="start-inline-btn" class="game-btn sfx-click">USE FLASHLIGHT</button>
        </div>

        <!-- Result Overlay -->
        <div id="game-result-screen" class="game-result-card">
          <h2 style="font-family:'Press Start 2P'; color:var(--primary); font-size:16px; margin-bottom:10px;">YOU FOUND
            ME!</h2>
          <p style="color:#aaa; font-size:12px; margin-bottom:20px;">I'M THE DESIGNER YOU'RE LOOKING FOR.</p>
          <div style="font-size:40px; margin-bottom:20px;">🐱🤝👤</div>

          <div style="display:flex; gap:10px; justify-content:center;">
            <a href="mailto:hello@michelle.design" class="game-btn sfx-click"
              style="text-decoration:none; color:#000; background:var(--primary); border-color:var(--primary);">HIRE ME
              NOW</a>
            <button onclick="startGame()" class="game-btn sfx-click"
              style="padding:10px 20px; background:transparent; color:#fff; border-color:#fff;">PLAY AGAIN</button>
          </div>
        </div>
      </div>

      <div class="mobile-controls">TAP THE DARKNESS TO SEARCH</div>
    </div>

    <!-- REPLACED: CODE OF CONDUCT -> EXP DATABASE -->
    <div class="section-title">04_EXP_DATABASE</div>
    <div class="grid-2">
      <div class="panel sfx-hover">
        <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:10px;">
          <span style="font-family:'Press Start 2P'; color:var(--primary); font-size:10px;">LVL. 25</span>
          <span class="exp-date">2023 - NOW</span>
        </div>
        <h3 style="margin:0 0 5px;">Senior Product Designer</h3>
        <div class="exp-company" style="margin-bottom:15px; color:#fff;">Tech Giant Co.</div>
        <p class="dim">Spearheading the gamification squad. Increased user retention by 40% through "Daily Quests" and
          social leaderboards.</p>
      </div>

      <div class="panel sfx-hover">
        <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:10px;">
          <span style="font-family:'Press Start 2P'; color:var(--secondary); font-size:10px;">LVL. 10</span>
          <span class="exp-date">2021 - 2023</span>
        </div>
        <h3 style="margin:0 0 5px;">UX Specialist</h3>
        <div class="exp-company" style="margin-bottom:15px; color:#fff;">StartUp Inc.</div>
        <p class="dim">Solo designer for 0-1 product launch. Created the design system "Nebula" and shipped the MVP in 3
          months.</p>
      </div>
    </div>

  </main>

  <footer class="contact-footer">
    <div style="font-family: 'Press Start 2P'; font-size: 12px; color: var(--text-dim); margin-bottom: 10px;">QUEST
      AVAILABLE</div>
    <a href="mailto:hello@michelle.design" class="contact-link sfx-hover">ACCEPT MISSION?</a>

    <div style="margin-top: 40px; display: flex; justify-content: center; gap: 20px;">
      <a href="#" class="skill-tag sfx-hover">LINKEDIN</a>
      <a href="#" class="skill-tag sfx-hover">TWITTER</a>
      <a href="#" class="skill-tag sfx-hover">BEHANCE</a>
    </div>

    <p style="margin-top: 60px; font-size: 12px; color: #333;">© 2025 Michelle UX Studio. Press Start to Continue.</p>
  </footer>

  <script>
    // Audio Engine
    const audioCtx = new (window.AudioContext || window.webkitAudioContext)();
    let audioEnabled = false;

    window.addEventListener('click', () => {
      if (!audioEnabled && audioCtx.state !== 'running') {
        audioCtx.resume();
        audioEnabled = true;
      }
    }, { once: true });

    function playTone(freq, type = 'sine', duration = 0.1) {
      if (audioCtx.state !== 'running') return;
      const osc = audioCtx.createOscillator();
      const gain = audioCtx.createGain();
      osc.type = type;
      osc.frequency.setValueAtTime(freq, audioCtx.currentTime);
      gain.gain.setValueAtTime(0.05, audioCtx.currentTime);
      gain.gain.exponentialRampToValueAtTime(0.001, audioCtx.currentTime + duration);
      osc.connect(gain);
      gain.connect(audioCtx.destination);
      osc.start();
      osc.stop(audioCtx.currentTime + duration);
    }

    document.querySelectorAll('.sfx-hover').forEach(el => {
      el.addEventListener('mouseenter', () => playTone(800, 'triangle', 0.05));
    });
    document.querySelectorAll('.sfx-click').forEach(el => {
      el.addEventListener('click', () => playTone(400, 'square', 0.1));
    });

    // Bio Typewriter
    const bioText = "I’m Michelle, a Product Designer obsessed with the intersection of complex systems and human emotion. I don't just design screens; I design the rules of play for digital products.";
    const bioContainer = document.getElementById('bio-text');
    let bioIndex = 0;
    function typeWriter() {
      if (bioIndex < bioText.length) {
        bioContainer.innerHTML += bioText.charAt(bioIndex);
        bioIndex++;
        if (bioIndex % 4 === 0) playTone(1200, 'sine', 0.03);
        setTimeout(typeWriter, 20);
      }
    }
    setTimeout(typeWriter, 800);

    // Coffee Counter
    const coffeeCounter = document.getElementById('coffee-counter');
    let coffeeCount = 8842;
    setInterval(() => {
      if (Math.random() > 0.7) {
        coffeeCount += Math.floor(Math.random() * 3);
        coffeeCounter.innerText = coffeeCount;
      }
    }, 200);

    // --- NEW: HACKER TEXT EFFECT ---
    const letters = "ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789!@#$%^&*";
    document.querySelectorAll('.hacker-text').forEach(item => {
      item.onmouseover = event => {
        let iterations = 0;
        const interval = setInterval(() => {
          event.target.innerText = event.target.innerText.split("")
            .map((letter, index) => {
              if (index < iterations) return event.target.dataset.value[index];
              return letters[Math.floor(Math.random() * 26)];
            })
            .join("");
          if (iterations >= event.target.dataset.value.length) clearInterval(interval);
          iterations += 1 / 2; // Speed of decoding
        }, 30);
      }
    });

    // --- NEW: HP/MP SIMULATION ---
    const mpBar = document.getElementById('mp-bar');
    const hpBar = document.getElementById('hp-bar');

    // MP Regen Loop
    let mpValue = 40;
    setInterval(() => {
      mpValue += 2;
      if (mpValue > 100) mpValue = 10; // Cycle reset to simulate brainstorming
      mpBar.style.width = `${mpValue}%`;
    }, 100);

    // HP Jitter (Caffeine heart rate)
    setInterval(() => {
      const jitter = 85 + (Math.random() * 10 - 5);
      hpBar.style.width = `${jitter}%`;
    }, 500);


    // --- UPDATED: Avatar Clicker (Loot Drop & Shake) ---
    const avatar = document.getElementById('avatar-clicker');
    const levelDisplay = document.getElementById('level-display');
    let level = 25;
    const dropIcons = ['🎨', '💻', '☕️', '✨', '🔥', '👾', '🚀', '+1 XP'];

    avatar.addEventListener('click', (e) => {
      // 1. Level Up
      level++;
      levelDisplay.innerText = level;

      // 2. Play Sound
      playTone(600 + (Math.random() * 200), 'square', 0.1);

      // 3. Shake Effect
      avatar.classList.remove('shake');
      void avatar.offsetWidth; // trigger reflow
      avatar.classList.add('shake');

      // 4. Spawn Floating Icon
      const icon = document.createElement('div');
      icon.innerText = dropIcons[Math.floor(Math.random() * dropIcons.length)];
      icon.className = 'float-icon';
      icon.style.color = Math.random() > 0.5 ? 'var(--primary)' : '#fff';

      const rect = avatar.getBoundingClientRect();
      // Randomize position slightly around click
      const offsetX = (Math.random() - 0.5) * 40;

      icon.style.left = `${e.clientX - rect.left + offsetX}px`;
      icon.style.top = `${e.clientY - rect.top}px`;

      avatar.appendChild(icon);
      setTimeout(() => icon.remove(), 1000);

      if (level % 10 === 0) showLog("LEVEL UP! NEW SKILL UNLOCKED?");
    });

    // Skills
    document.querySelectorAll('#skill-tree .skill-tag').forEach(skill => {
      skill.addEventListener('click', function () {
        this.classList.toggle('equipped');
        if (this.classList.contains('equipped')) {
          playTone(1500, 'sine', 0.2);
          showLog(`EQUIPPED: ${this.innerText}`);
        } else {
          playTone(200, 'sine', 0.2);
          showLog(`UNEQUIPPED: ${this.innerText}`);
        }
      });
    });

    const logBox = document.getElementById('sys-log');
    let logTimeout;
    function showLog(msg) {
      logBox.innerText = `SYSTEM: ${msg}`;
      logBox.style.display = 'block';
      clearTimeout(logTimeout);
      logTimeout = setTimeout(() => {
        logBox.style.display = 'none';
      }, 2000);
    }

    const cmdInput = document.getElementById('cmd-input');
    cmdInput.addEventListener('keydown', (e) => {
      if (e.key === 'Enter') {
        const cmd = cmdInput.value.toLowerCase().trim();
        cmdInput.value = '';
        playTone(300, 'square', 0.1);
        switch (cmd) {
          case '/help': alert("AVAILABLE COMMANDS:\n/help - Show this list\n/coffee - Refill caffeine\n/contact - Send email\n/home - Go back"); break;
          case '/coffee': coffeeCount += 100; coffeeCounter.innerText = coffeeCount; showLog("CAFFEINE OVERLOAD!"); break;
          case '/contact': window.location.href = "mailto:hello@michelle.design"; showLog("OPENING MAIL CLIENT..."); break;
          case '/home': window.location.href = "index.html"; break;
          default: showLog("UNKNOWN COMMAND. TRY /HELP");
        }
      }
    });

    // --- PAGE FLIP LOGIC ---
    // Simple logic: clicking a page toggles 'flipped' class.
    // Since we stacked them, we flip the top one (z-index highest) to reveal the one below.
    window.flipPage = function (el) {
      el.classList.toggle('flipped');
      playTone(400, 'sine', 0.1); // Page turn sound
    };

    // --- HIDE & SEEK GAME LOGIC ---
    const startInlineBtn = document.getElementById('start-inline-btn');
    const startScreen = document.getElementById('game-start-screen');
    const resultScreen = document.getElementById('game-result-screen');
    const statusEl = document.getElementById('seek-status');
    const timerEl = document.getElementById('seek-timer');
    const gameContainer = document.getElementById('game-container');

    // Canvas setup
    const canvasGame = document.getElementById('game-board');
    const ctxGame = canvasGame.getContext('2d');

    let gameActive = false;
    let elapsedTime = 0;
    let lastTime = 0;

    // Target (The Cat)
    const target = { x: 0, y: 0, size: 40, icon: '🐱', moveTimer: 0, moveInterval: 0.8 }; // Moves every 0.8s

    // Flashlight
    const flashlight = { x: -100, y: -100, radius: 60 };

    startInlineBtn.addEventListener('click', startGame);

    function startGame() {
      gameActive = true;
      elapsedTime = 0;
      target.moveTimer = 0;
      moveTarget();

      statusEl.innerText = "SEARCHING...";
      statusEl.style.color = "var(--primary)";
      timerEl.innerText = "0.0";

      startScreen.style.display = 'none';
      resultScreen.style.display = 'none';

      // Mouse/Touch tracking for flashlight
      canvasGame.addEventListener('mousemove', updateFlashlight);
      canvasGame.addEventListener('touchmove', updateFlashlight, { passive: false });
      // Click to catch
      canvasGame.addEventListener('mousedown', tryCatch);
      canvasGame.addEventListener('touchstart', tryCatch, { passive: false });

      playTone(440, 'sine', 0.3);

      lastTime = performance.now();
      requestAnimationFrame(gameLoop);
    }

    function moveTarget() {
      const padding = 50;
      target.x = Math.random() * (canvasGame.width - padding * 2) + padding;
      target.y = Math.random() * (canvasGame.height - padding * 2) + padding;
    }

    function updateFlashlight(e) {
      if (!gameActive) return;
      if (e.type === 'touchmove') e.preventDefault();

      const rect = canvasGame.getBoundingClientRect();
      const clientX = e.touches ? e.touches[0].clientX : e.clientX;
      const clientY = e.touches ? e.touches[0].clientY : e.clientY;

      const scaleX = canvasGame.width / rect.width;
      const scaleY = canvasGame.height / rect.height;

      flashlight.x = (clientX - rect.left) * scaleX;
      flashlight.y = (clientY - rect.top) * scaleY;
    }

    function tryCatch(e) {
      if (!gameActive) return;
      if (e.type === 'touchstart') e.preventDefault();

      // Check distance to target
      const dx = flashlight.x - target.x;
      const dy = flashlight.y - target.y;
      const dist = Math.sqrt(dx * dx + dy * dy);

      // Allow catch if flashlight is close enough (visible) AND clicked
      if (dist < flashlight.radius) {
        endGame(true);
      } else {
        playTone(150, 'sawtooth', 0.1); // Miss sound
      }
    }

    function update(dt) {
      elapsedTime += dt;
      timerEl.innerText = elapsedTime.toFixed(1);

      // Move target periodically
      target.moveTimer += dt;
      if (target.moveTimer > target.moveInterval) {
        moveTarget();
        target.moveTimer = 0;
        // Play faint sound on move
        // playTone(800, 'sine', 0.02); 
      }
    }

    function draw() {
      // 1. Draw Black Background
      ctxGame.fillStyle = '#000';
      ctxGame.fillRect(0, 0, canvasGame.width, canvasGame.height);

      // 2. Draw Target (Hidden in dark, but we draw it first)
      ctxGame.font = "40px Arial";
      ctxGame.textAlign = "center";
      ctxGame.textBaseline = "middle";
      ctxGame.fillText(target.icon, target.x, target.y);

      // 3. Create Darkness Mask with Hole
      // Reset composite to draw overlay
      ctxGame.globalCompositeOperation = 'source-over';

      // Create path for the mask: Whole screen RECT + Counter-clockwise Circle hole
      ctxGame.fillStyle = 'rgba(0,0,0,0.98)'; // Very dark
      ctxGame.beginPath();
      ctxGame.rect(0, 0, canvasGame.width, canvasGame.height);
      ctxGame.arc(flashlight.x, flashlight.y, flashlight.radius, 0, Math.PI * 2, true);
      ctxGame.fill();

      // Draw flashlight ring
      ctxGame.strokeStyle = 'rgba(255,255,255,0.2)';
      ctxGame.lineWidth = 2;
      ctxGame.beginPath();
      ctxGame.arc(flashlight.x, flashlight.y, flashlight.radius, 0, Math.PI * 2);
      ctxGame.stroke();
    }

    function gameLoop(timestamp) {
      if (!gameActive) return;
      const dt = (timestamp - lastTime) / 1000;
      lastTime = timestamp;

      update(dt);
      draw();

      if (gameActive) requestAnimationFrame(gameLoop);
    }

    function endGame(win) {
      gameActive = false;
      canvasGame.removeEventListener('mousemove', updateFlashlight);
      canvasGame.removeEventListener('touchmove', updateFlashlight);
      canvasGame.removeEventListener('mousedown', tryCatch);
      canvasGame.removeEventListener('touchstart', tryCatch);

      if (win) {
        playTone(600, 'square', 0.1);
        setTimeout(() => playTone(800, 'square', 0.2), 100);
        setTimeout(() => playTone(1200, 'square', 0.4), 200);

        statusEl.innerText = "CAUGHT!";
        resultScreen.style.display = 'flex';
      }
    }

    // Canvas & Mouse Trail (Background)
    const canvas = document.getElementById('canvas');
    const ctx = canvas.getContext('2d');
    const colors = ['#c3ff00', '#7000ff', '#333'];
    let particles = [];

    function resizeCanvas() {
      canvas.width = window.innerWidth;
      canvas.height = window.innerHeight;
    }
    window.addEventListener('resize', resizeCanvas);
    resizeCanvas();

    window.addEventListener('mousemove', (e) => {
      if (Math.random() > 0.5) {
        particles.push({
          x: e.clientX, y: e.clientY,
          size: Math.random() * 4 + 2,
          color: colors[Math.floor(Math.random() * 2)],
          life: 1
        });
      }
    });

    function drawPixel() {
      ctx.clearRect(0, 0, canvas.width, canvas.height);
      if (Math.random() > 0.8) {
        ctx.fillStyle = '#333';
        ctx.fillRect(Math.random() * canvas.width, Math.random() * canvas.height, 2, 2);
      }
      for (let i = 0; i < particles.length; i++) {
        const p = particles[i];
        ctx.fillStyle = p.color;
        ctx.globalAlpha = p.life;
        ctx.fillRect(p.x, p.y, p.size, p.size);
        ctx.globalAlpha = 1;
        p.life -= 0.05;
        p.y += 1;
        if (p.life <= 0) { particles.splice(i, 1); i--; }
      }
      requestAnimationFrame(drawPixel);
    }
    drawPixel();

    window.addEventListener('scroll', () => {
      const doc = document.documentElement;
      const progress = (doc.scrollTop || document.body.scrollTop) / (doc.scrollHeight - doc.clientHeight) || 0;
      document.getElementById("bar").style.transform = `scaleX(${progress})`;
    });

  </script>
</body>

</html>