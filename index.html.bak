    <script src="js/app.js"></script>
    <script>
        // Material Reveal Mouse Tracking
        document.addEventListener('DOMContentLoaded', () => {
            const revealContainer = document.querySelector('.reveal-container');
            const section = document.querySelector('.material-reveal-section');

            if (revealContainer) {
                console.log("Material Reveal Initialized");

                // Track mouse over the entire window to robustly update position
                window.addEventListener('mousemove', (e) => {
                    const rect = revealContainer.getBoundingClientRect();

                    // Check if we are near the section to safe resources? 
                    // No, just track continuously for smoothness.

                    const x = e.clientX - rect.left;
                    const y = e.clientY - rect.top;

                    revealContainer.style.setProperty('--x', `${x}px`);
                    revealContainer.style.setProperty('--y', `${y}px`);
                });
            } else {
                console.error("Material Reveal container NOT found");
            }
        });
    </script>
</body>

