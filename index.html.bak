<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Zirong | Algorithmic Portfolio</title>
    <link
        href="https://fonts.googleapis.com/css2?family=Inter:wght@400;700;900&family=JetBrains+Mono:wght@400&display=swap"
        rel="stylesheet">

    <style>
        :root {
            --primary: #DA205A;
            --bg: #050507;
            /* Updated to darker ambient bg */
            --text: #ffffff;
        }

        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            background: var(--bg);
            color: var(--text);
            font-family: 'Inter', sans-serif;
            overflow-x: hidden;
            cursor: crosshair;
        }

        .font-mono {
            font-family: 'JetBrains Mono', monospace;
        }

        /* Utility approximations of Tailwind classes */
        .min-h-200vh {
            min-height: 200vh;
        }

        .fixed {
            position: fixed;
        }

        .absolute {
            position: absolute;
        }

        .relative {
            position: relative;
        }

        .inset-0 {
            top: 0;
            right: 0;
            bottom: 0;
            left: 0;
        }

        .z-0 {
            z-index: 0;
        }

        .z-10 {
            z-index: 10;
        }

        .z-50 {
            z-index: 50;
        }

        .flex {
            display: flex;
        }

        .items-center {
            align-items: center;
        }

        .justify-center {
            justify-content: center;
        }

        .text-center {
            text-align: center;
        }

        .w-full {
            width: 100%;
        }

        .h-screen {
            height: 100vh;
        }

        /* Typography */
        .text-6xl {
            font-size: 3.75rem;
        }

        .md-text-8xl {
            font-size: 6rem;
        }

        .font-black {
            font-weight: 900;
        }

        .tracking-tighter {
            letter-spacing: -0.05em;
        }

        .mix-blend-difference {
            mix-blend-mode: difference;
        }

        .text-primary {
            color: var(--primary);
        }

        .text-gray-400 {
            color: #9ca3af;
        }

        .text-sm {
            font-size: 0.875rem;
        }

        /* Buttons/Badges */
        .badge-container {
            display: inline-block;
            background: rgba(218, 32, 90, 0.1);
            backdrop-filter: blur(12px);
            border: 1px solid rgba(218, 32, 90, 0.2);
            padding: 0.5rem 1.5rem;
            border-radius: 9999px;
        }

        .animate-pulse {
            animation: pulse 2s cubic-bezier(0.4, 0, 0.6, 1) infinite;
        }

        @keyframes pulse {

            0%,
            100% {
                opacity: 1;
            }

            50% {
                opacity: .5;
            }
        }

        /* Grid for Projects */
        .grid {
            display: grid;
        }

        .grid-cols-1 {
            grid-template-columns: repeat(1, minmax(0, 1fr));
        }

        .gap-8 {
            gap: 2rem;
        }

        .p-20 {
            padding: 5rem;
        }

        .mx-auto {
            margin-left: auto;
            margin-right: auto;
        }

        .max-w-7xl {
            max-width: 80rem;
        }

        @media (min-width: 768px) {
            .md-grid-cols-2 {
                grid-template-columns: repeat(2, minmax(0, 1fr));
            }

            h1 {
                font-size: 6rem;
            }
        }

        /* Cards */
        .card {
            position: relative;
            padding: 2rem;
            background: rgba(255, 255, 255, 0.05);
            backdrop-filter: blur(20px);
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 1rem;
            transition: all 0.3s ease;
        }

        .card:hover {
            border-color: rgba(218, 32, 90, 0.5);
        }

        .card-hover-bg {
            position: absolute;
            inset: 0;
            background: rgba(218, 32, 90, 0.05);
            opacity: 0;
            transition: opacity 0.3s ease;
            border-radius: 1rem;
        }

        .card:hover .card-hover-bg {
            opacity: 1;
        }

        .top-glow {
            background: conic-gradient(from 180deg at 50% 0%, #DA205A, transparent);
            filter: blur(80px);
            height: 500px;
            width: 100%;
            position: fixed;
            top: 0;
            left: 0;
            opacity: 0.2;
            pointer-events: none;
        }

        /* Nav (Back to Pixel World) */
        .switch-btn {
            position: fixed;
            top: 20px;
            right: 20px;
            z-index: 100;
            background: rgba(255, 255, 255, 0.1);
            color: #fff;
            padding: 10px 20px;
            border-radius: 8px;
            border: 1px solid rgba(255, 255, 255, 0.2);
            font-family: 'JetBrains Mono', monospace;
            font-size: 12px;
            transition: 0.3s;
            text-decoration: none;
        }

        .switch-btn:hover {
            background: var(--primary);
            border-color: var(--primary);
        }

        ::-webkit-scrollbar {
            width: 5px;
        }

        ::-webkit-scrollbar-track {
            background: #050505;
        }

        ::-webkit-scrollbar-thumb {
            background: #DA205A;
            border-radius: 10px;
        }

        /* New Utilities for Profile Hero */
        .glass-card {
            background: rgba(10, 10, 10, 0.6);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            box-shadow: 0 20px 50px rgba(0, 0, 0, 0.5);
        }

        .border-white\/10 {
            border-color: rgba(255, 255, 255, 0.1);
        }

        .border-white\/20 {
            border-color: rgba(255, 255, 255, 0.2);
        }

        .border-white\/30 {
            border-color: rgba(255, 255, 255, 0.3);
        }

        .bg-white\/5 {
            background-color: rgba(255, 255, 255, 0.05);
        }

        .bg-white\/10 {
            background-color: rgba(255, 255, 255, 0.1);
        }

        .bg-green-900\/30 {
            background-color: rgba(20, 83, 45, 0.3);
        }

        .border-green-500\/20 {
            border-color: rgba(34, 197, 94, 0.2);
        }

        .bg-green-500 {
            background-color: #22c55e;
        }

        .text-green-400 {
            color: #4ade80;
        }

        .rounded-3xl {
            border-radius: 1.5rem;
        }

        .rounded-full {
            border-radius: 9999px;
        }

        .p-12 {
            padding: 3rem;
        }

        .px-4 {
            padding-left: 1rem;
            padding-right: 1rem;
        }

        .py-2 {
            padding-top: 0.5rem;
            padding-bottom: 0.5rem;
        }

        .px-8 {
            padding-left: 2rem;
            padding-right: 2rem;
        }

        .py-4 {
            padding-top: 1rem;
            padding-bottom: 1rem;
        }

        .mb-12 {
            margin-bottom: 3rem;
        }

        .gap-2 {
            gap: 0.5rem;
        }

        .gap-3 {
            gap: 0.75rem;
        }

        .gap-4 {
            gap: 1rem;
        }

        .gap-6 {
            gap: 1.5rem;
        }

        .text-xs {
            font-size: 0.75rem;
            line-height: 1rem;
        }

        .text-lg {
            font-size: 1.125rem;
            line-height: 1.75rem;
        }

        .text-5xl {
            font-size: 3rem;
            line-height: 1;
        }

        .md\:text-7xl {
            font-size: 4.5rem;
            line-height: 1;
        }

        .font-bold {
            font-weight: 700;
        }

        .font-medium {
            font-weight: 500;
        }

        .uppercase {
            text-transform: uppercase;
        }

        .tracking-wide {
            letter-spacing: 0.025em;
        }

        .tracking-tight {
            letter-spacing: -0.025em;
        }

        .leading-tight {
            line-height: 1.25;
        }

        .object-cover {
            object-fit: cover;
        }

        .overflow-hidden {
            overflow: hidden;
        }

        .flex-wrap {
            flex-wrap: wrap;
        }

        .items-center {
            align-items: center;
        }

        .justify-between {
            justify-content: space-between;
        }

        .w-16 {
            width: 4rem;
        }

        .h-16 {
            height: 4rem;
        }

        .w-2 {
            width: 0.5rem;
        }

        .h-2 {
            height: 0.5rem;
        }

        .hover\:scale-105:hover {
            transform: scale(1.05);
        }

        .transition-all {
            transition-property: all;
            transition-timing-function: cubic-bezier(0.4, 0, 0.2, 1);
            transition-duration: 300ms;
        }

        .transition-colors {
            transition-property: color, background-color, border-color, text-decoration-color, fill, stroke;
            transition-timing-function: cubic-bezier(0.4, 0, 0.2, 1);
            transition-duration: 300ms;
        }

        .text-transparent {
            color: transparent;
        }

        .bg-clip-text {
            -webkit-background-clip: text;
            background-clip: text;
        }

        .bg-gradient-to-r {
            background-image: linear-gradient(to right, var(--tw-gradient-stops));
        }

        .from-white {
            --tw-gradient-from: #fff;
            --tw-gradient-stops: var(--tw-gradient-from), var(--tw-gradient-to, rgba(255, 255, 255, 0));
        }

        .to-gray-500 {
            --tw-gradient-to: #6b7280;
        }

        /* Mobile specific adjustments */
        @media (max-width: 768px) {
            .md\:text-7xl {
                font-size: 3rem;
            }

            /* Fallback */
            .hidden.md\:block {
                display: none;
            }

            .p-12 {
                padding: 1.5rem;
            }
        }

        /* Container Alignment */
        .studio-showcase {
            max-width: 1280px;
            margin: 0 auto;
            padding: 140px 5%;
            position: relative;
            z-index: 10;
        }

        /* Studio Card - Glassmorphism & Interaction */
        .studio-card {
            display: block;
            position: relative;
            background: rgba(255, 255, 255, 0.03);
            /* Glass Base */
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            border: 1px solid rgba(255, 255, 255, 0.08);
            border-radius: 24px;
            padding: 48px;
            text-decoration: none;
            transition: all 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94);
            /* Smooth transition */
            overflow: hidden;
            margin-bottom: 24px;
            /* Spacing */
        }

        /* Hover Effect: Scale & Brighten */
        .studio-card:hover {
            transform: scale(1.02);
            /* Zoom effect */
            background: rgba(255, 255, 255, 0.07);
            border-color: rgba(218, 32, 90, 0.5);
            /* Primary color hint */
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.4);
            z-index: 10;
        }

        /* Typography fixes for the card contents */
        .studio-label {
            font-family: 'JetBrains Mono', monospace;
            font-size: 12px;
            color: rgba(255, 255, 255, 0.5);
            display: block;
            margin-bottom: 16px;
            letter-spacing: 1px;
        }

        .studio-heading,
        .project-title {
            font-family: 'Inter', sans-serif;
            color: #fff;
            margin: 0 0 16px 0;
        }

        .studio-heading {
            font-size: 48px;
            font-weight: 800;
            line-height: 1.1;
        }

        .project-title {
            font-size: 32px;
            font-weight: 700;
        }

        .studio-desc {
            font-family: 'Inter', sans-serif;
            font-size: 16px;
            color: rgba(255, 255, 255, 0.7);
            line-height: 1.6;
            margin-bottom: 32px;
        }

        .studio-impact {
            font-family: 'JetBrains Mono', monospace;
            font-size: 12px;
            color: rgba(255, 255, 255, 0.4);
            border-top: 1px solid rgba(255, 255, 255, 0.1);
            padding-top: 20px;
            margin-top: auto;
        }

        .studio-link {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            margin-top: 24px;
            font-size: 14px;
            font-weight: 700;
            color: var(--primary);
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        /* Grid Layout Fixes */
        .studio-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
            gap: 24px;
        }

        /* =========================================
           6. PROJECT MOCKUPS & VISUALS
           ========================================= */

        .project-visual {
            width: 100%;
            /* Fixed constraint for grid items */
            max-height: 240px;
            border-radius: 12px;
            overflow: hidden;
            margin-bottom: 24px;
            background: rgba(0, 0, 0, 0.2);
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.2);
            border: 1px solid rgba(255, 255, 255, 0.05);
            position: relative;
            /* Center the image */
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .project-visual img {
            width: auto;
            height: auto;
            max-width: 100%;
            max-height: 100%;
            object-fit: contain;
            display: block;
            transition: transform 0.6s cubic-bezier(0.25, 0.46, 0.45, 0.94);
        }

        .studio-card:hover .project-visual img {
            transform: scale(1.03);
        }

        .mockup-placeholder {
            width: 100%;
            height: 100%;
            min-height: 180px;
            background: radial-gradient(circle at center, rgba(255, 255, 255, 0.03) 0%, rgba(255, 255, 255, 0.01) 100%);
            display: flex;
            align-items: center;
            justify-content: center;
        }

        /* Specific adjustment for the hero card visual */
        .hero-project .project-visual {
            margin-bottom: 32px;
            max-height: 360px;
            /* Reduced from 480px */
            background: transparent;
            border: none;
            box-shadow: none;
        }

        .hero-project .project-visual img {
            max-height: 100%;
            width: auto;
            max-width: 100%;
            border-radius: 12px;
            box-shadow: 0 20px 50px rgba(0, 0, 0, 0.5);
        }

        /* =========================================
           7. ANIMATED BACKGROUNDS (Uiverse)
           ========================================= */
        .card-bg-animation {
            position: absolute;
            inset: 0;
            z-index: -1;
            opacity: 0.3;
            pointer-events: none;
            overflow: hidden;
        }

        .card-bg-animation svg {
            width: 100%;
            height: 100%;
        }

        .grid-line {
            stroke: rgba(255, 255, 255, 0.05);
            /* Subtle grid */
            stroke-width: 0.5;
        }

        .trace-flow {
            stroke-width: 2;
            fill: none;
            stroke-dasharray: 120 600;
            stroke-dashoffset: 720;
            animation: flow 5s linear infinite;
            opacity: 0.8;
            stroke-linejoin: round;
            filter: drop-shadow(0 0 8px currentColor);
            color: #00ccff;
        }

        .trace-flow:nth-child(1) {
            stroke: url(#traceGradient1);
        }

        .trace-flow:nth-child(2) {
            stroke: url(#traceGradient2);
        }

        .trace-flow:nth-child(3) {
            stroke: url(#traceGradient3);
        }

        .trace-flow:nth-child(4) {
            stroke: url(#traceGradient4);
        }

        @keyframes flow {
            from {
                stroke-dashoffset: 720;
            }

            to {
                stroke-dashoffset: 0;
            }
        }

        /* =========================================
           8. CTA BUTTONS
           ========================================= */
        .studio-btn {
            padding: 14px 36px;
            border-radius: 100px;
            border: 1px solid rgba(255, 255, 255, 0.2);
            font-family: 'JetBrains Mono', monospace;
            font-size: 14px;
            color: #fff;
            text-decoration: none;
            transition: 0.3s cubic-bezier(0.25, 0.46, 0.45, 0.94);
            background: rgba(255, 255, 255, 0.02);
            display: inline-flex;
            align-items: center;
            justify-content: center;
            backdrop-filter: blur(4px);
        }

        .studio-btn:hover {
            transform: translateY(-2px);
            background: rgba(255, 255, 255, 0.1);
            border-color: #fff;
            box-shadow: 0 10px 20px rgba(0, 0, 0, 0.3);
        }

        .studio-btn.primary {
            border-color: rgba(218, 32, 90, 0.6);
            background: rgba(218, 32, 90, 0.1);
        }

        .studio-btn.primary:hover {
            background: rgba(218, 32, 90, 0.2);
            border-color: var(--primary);
            box-shadow: 0 0 30px rgba(218, 32, 90, 0.4);
            color: #fff;
        }

        .studio-btn.secondary {
            color: #aaa;
        }

        .studio-btn.secondary:hover {
            color: #fff;
        }
    </style>
</head>

<body>

    <!-- Top Glow -->
    <div class="top-glow"></div>

    <!-- GLOBAL SVG DEFS (Hidden) -->
    <svg style="position: absolute; width: 0; height: 0; overflow: hidden;" aria-hidden="true">
        <defs>
            <linearGradient id="traceGradient1" x1="250" y1="120" x2="100" y2="200" gradientUnits="userSpaceOnUse">
                <stop offset="0%" stop-color="#00ccff" stop-opacity="1"></stop>
                <stop offset="100%" stop-color="#00ccff" stop-opacity="0.5"></stop>
            </linearGradient>
            <linearGradient id="traceGradient2" x1="650" y1="120" x2="800" y2="300" gradientUnits="userSpaceOnUse">
                <stop offset="0%" stop-color="#00ccff" stop-opacity="1"></stop>
                <stop offset="100%" stop-color="#00ccff" stop-opacity="0.5"></stop>
            </linearGradient>
            <linearGradient id="traceGradient3" x1="250" y1="380" x2="400" y2="400" gradientUnits="userSpaceOnUse">
                <stop offset="0%" stop-color="#00ccff" stop-opacity="1"></stop>
                <stop offset="100%" stop-color="#00ccff" stop-opacity="0.5"></stop>
            </linearGradient>
            <linearGradient id="traceGradient4" x1="650" y1="120" x2="500" y2="100" gradientUnits="userSpaceOnUse">
                <stop offset="0%" stop-color="#00ccff" stop-opacity="1"></stop>
                <stop offset="100%" stop-color="#00ccff" stop-opacity="0.5"></stop>
            </linearGradient>
        </defs>
    </svg>

    <!-- Mouse Light Follower -->
    <div id="mouse-follower" class="mouse-follower"></div>

    <!-- Global Glass Navigation -->
    <header class="switch-btn"
        style="all: unset; position: fixed; top: 20px; width: 100%; display: flex; justify-content: center; z-index: 2000; pointer-events: none;">
        <nav
            style="pointer-events: auto; background: rgba(5, 5, 5, 0.6); backdrop-filter: blur(16px); padding: 8px 12px; border-radius: 100px; border: 1px solid rgba(255,255,255,0.1); display: flex; gap: 8px;">
            <a href="index.html"
                style="color: #fff; text-decoration: none; padding: 8px 16px; font-size: 14px; font-family: 'Inter', sans-serif;">Home</a>
            <a href="about-me.html"
                style="color: #999; text-decoration: none; padding: 8px 16px; font-size: 14px; font-family: 'Inter', sans-serif; transition: 0.3s;"
                onmouseover="this.style.color='#fff'" onmouseout="this.style.color='#999'">About Me</a>
            <a href="resume.pdf" target="_blank"
                style="color: #999; text-decoration: none; padding: 8px 16px; font-size: 14px; font-family: 'Inter', sans-serif; transition: 0.3s;"
                onmouseover="this.style.color='#fff'" onmouseout="this.style.color='#999'">Resume</a>
            <a href="mailto:hello@example.com"
                style="color: #999; text-decoration: none; padding: 8px 16px; font-size: 14px; font-family: 'Inter', sans-serif; transition: 0.3s;"
                onmouseover="this.style.color='#fff'" onmouseout="this.style.color='#999'">Contact Me</a>
        </nav>
    </header>

    <!-- Hero Section -->
    <section class="relative h-screen flex items-center justify-center overflow-hidden">
        <canvas id="pixel-canvas" class="absolute inset-0 z-0"></canvas>

        <div class="z-10 relative w-full px-6 text-center pointer-events-none">

            <!-- Massive Name (Original Style) -->
            <h1 class="text-6xl md:text-9xl font-black tracking-tighter mb-2 text-white mix-blend-difference"
                style="line-height: 0.9;">
                MICHELLE <span class="text-primary">GUAN</span>
            </h1>

            <!-- Monospace Subtitle -->
            <div class="mb-8">
                <p class="font-mono text-sm md:text-base tracking-widest text-primary animate-pulse">
                    &gt; AI_PRODUCT_DESIGNER
                    <span class="text-white opacity-50 mx-2">|</span>
                    AVAILABLE_FOR_WORK_
                </p>
            </div>

            <!-- Impact Headline (Secondary) -->
            <h2
                class="text-lg md:text-2xl text-gray-300 font-light max-w-2xl mx-auto mb-10 leading-relaxed mix-blend-difference">
                Partnering with bold teams to <span class="text-white font-medium">design fast</span> and <span
                    class="text-white font-medium">ship smart</span>.
            </h2>

            <!-- Actions (Pointer Events Auto) -->
            <div class="pointer-events-auto flex flex-col md:flex-row justify-center items-center gap-6 mb-12">
                <a href="mailto:hello@example.com" class="studio-btn primary">
                    SCHEDULE_CHAT
                </a>

                <a href="resume.pdf" target="_blank" class="studio-btn secondary">
                    VIEW_RESUME
                </a>
            </div>

            <!-- Tags (Minimal) -->
            <div class="flex flex-wrap justify-center gap-4 text-xs font-mono text-gray-500 tracking-wider uppercase">
                <span>AI/HEALTHCARE</span>
                <span>•</span>
                <span>GLOBAL_EXPERIENCE</span>
                <span>•</span>
                <span>3X_LAUNCHES</span>
            </div>

        </div>
    </section>

    <!-- Premium Studio Style Showcase (Glass Card Version) -->
    <section class="studio-showcase">

        <!-- HERO CASE: UNIMO -->
        <a href="unimo.html" class="hero-project studio-card">
            <div class="card-bg-animation">
                <svg viewBox="0 0 900 900" preserveAspectRatio="none">
                    <g class="grid-group">
                        <line x1="0" y1="0" x2="0" y2="100%" class="grid-line"></line>
                        <line x1="100" y1="0" x2="100" y2="100%" class="grid-line"></line>
                        <line x1="200" y1="0" x2="200" y2="100%" class="grid-line"></line>
                        <line x1="300" y1="0" x2="300" y2="100%" class="grid-line"></line>
                        <line x1="400" y1="0" x2="400" y2="100%" class="grid-line"></line>
                        <line x1="500" y1="0" x2="500" y2="100%" class="grid-line"></line>
                        <line x1="600" y1="0" x2="600" y2="100%" class="grid-line"></line>
                        <line x1="700" y1="0" x2="700" y2="100%" class="grid-line"></line>
                        <line x1="800" y1="0" x2="800" y2="100%" class="grid-line"></line>
                        <line x1="900" y1="0" x2="900" y2="100%" class="grid-line"></line>
                        <line x1="0" y1="100" x2="100%" y2="100" class="grid-line"></line>
                        <line x1="0" y1="200" x2="100%" y2="200" class="grid-line"></line>
                        <line x1="0" y1="300" x2="100%" y2="300" class="grid-line"></line>
                        <line x1="0" y1="400" x2="100%" y2="400" class="grid-line"></line>
