/**
 * CYBERPUNK CARD INTERFACE
 * Vanilla JS Port of the React Concept
 */

// --- DATA ---
const PROJECTS = [
  {
    id: 'p1',
    title: 'Neon Nexus',
    category: 'UI/UX Design',
    desc: 'Cyberpunk dashboard interface for crypto analytics.',
    color: 'linear-gradient(135deg, #a855f7, #4f46e5)', // purple to indigo
    content: 'A deep dive into high-density data visualization using WebGL and dark mode aesthetics.'
  },
  {
    id: 'p2',
    title: 'Void Walker',
    category: 'Game Concept',
    desc: 'Character design and environmental art for a sci-fi rogue-like.',
    color: 'linear-gradient(135deg, #3b82f6, #22d3ee)', // blue to cyan
    content: 'Exploration of atmospheric lighting and procedural generation concepts.'
  },
  {
    id: 'p3',
    title: 'Echo Branding',
    category: 'Identity',
    desc: 'Dynamic logo system for an AI audio startup.',
    color: 'linear-gradient(135deg, #34d399, #0d9488)', // emerald to teal
    content: 'Generative identity system that reacts to sound input in real-time.'
  },
  {
    id: 'p4',
    title: 'Flux OS',
    category: 'System Design',
    desc: 'Conceptual operating system for AR glasses.',
    color: 'linear-gradient(135deg, #f43f5e, #fb923c)', // rose to orange
    content: 'Gesture-based interaction models and spatial computing paradigms.'
  }
];

// --- APP STATE ---
const State = {
  loading: true,
  bootProgress: 0,
  cards: [],
  maxZ: 10,
  draggingId: null,
  startPos: { x: 0, y: 0 },
  cardStartPos: { x: 0, y: 0 },
  isOverReader: false,
  activeProject: null
};

// --- DOM ELEMENTS ---
const Elements = {};

document.addEventListener('DOMContentLoaded', () => {
  // Initialize Icons
  lucide.createIcons();

  // Cache Elements
  Elements.loadingScreen = document.getElementById('loading-screen');
  Elements.mainInterface = document.getElementById('main-interface');
  Elements.loaderBar = document.getElementById('loader-bar');
  Elements.loaderGlitch = document.getElementById('loader-glitch');
  Elements.bootPercent = document.getElementById('boot-percent');
  Elements.bootText = document.getElementById('boot-text');

  Elements.workDeck = document.getElementById('work-deck');
  Elements.readerUnit = document.getElementById('reader-unit');
  Elements.readerText = document.getElementById('reader-text');

  Elements.modal = document.getElementById('project-modal');
  Elements.drawer = document.getElementById('about-drawer');

  // Start Boot Sequence
  startBootSequence();

  // Event Listeners for UI
  document.getElementById('btn-profile').addEventListener('click', () => toggleDrawer(true));
  document.getElementById('btn-close-drawer').addEventListener('click', () => toggleDrawer(false));
  document.getElementById('btn-close-modal').addEventListener('click', () => toggleModal(false));
});

// --- 1. BOOT SEQUENCE ---
function startBootSequence() {
  const interval = setInterval(() => {
    if (State.bootProgress >= 100) {
      clearInterval(interval);
      finishBoot();
      return;
    }

    // Random increment
    const inc = State.bootProgress > 80 ? Math.random() * 10 + 5 : Math.random() * 4 + 1;
    State.bootProgress = Math.min(State.bootProgress + inc, 100);

    // Update UI
    const pct = Math.floor(State.bootProgress) + '%';
    Elements.bootPercent.innerText = pct;
    Elements.loaderBar.style.width = pct;
    Elements.loaderGlitch.style.left = pct;

    // Update Text
    if (State.bootProgress > 30 && State.bootProgress < 70) {
      Elements.bootText.innerText = "CALIBRATING AESTHETICS...";
    } else if (State.bootProgress >= 70) {
      Elements.bootText.innerText = "LOADING ASSETS...";
    }

  }, 100);
}

function finishBoot() {
  Elements.bootText.innerText = "SYSTEM READY";
  setTimeout(() => {
    Elements.loadingScreen.classList.add('hidden'); // Or fade out class
    Elements.loadingScreen.style.opacity = '0';
    setTimeout(() => Elements.loadingScreen.style.display = 'none', 800);

    Elements.mainInterface.classList.remove('hidden');
    initCards();
  }, 600);
}

// --- 2. CARD SYSTEM ---
function initCards() {
  const container = Elements.workDeck;
  const { width, height } = container.getBoundingClientRect();
  const CARD_W = 300;
  const CARD_H = 180;

  PROJECTS.forEach((p, i) => {
    // Scatter Logic
    const zone = i % 3;
    let x, y;
    const margin = 50;

    if (zone === 0) { // Left
      x = randomRange(margin, width * 0.3 - CARD_W);
      y = randomRange(height * 0.2, height - CARD_H - margin);
    } else if (zone === 1) { // Top
      x = randomRange(width * 0.2, width * 0.8 - CARD_W);
      y = randomRange(height * 0.15, height * 0.5 - CARD_H);
    } else { // Right
      x = randomRange(width * 0.7, width - CARD_W - margin);
      y = randomRange(height * 0.2, height - CARD_H - margin);
    }

    // Safety clamp
    x = Math.max(margin, Math.min(x, width - CARD_W - margin));
    y = Math.max(margin, Math.min(y, height - CARD_H - margin));

    // Create Element
    const card = document.createElement('div');
    card.className = 'card-item';
    card.id = p.id;
    card.style.transform = `translate3d(${x}px, ${y}px, 0) rotate(${randomRange(-12, 12)}deg)`;
    card.style.zIndex = i + 1;

    // Inner HTML
    card.innerHTML = `
            <div class="card-inner" style="background: ${p.color}">
                <div class="card-overlay"></div>
                <div class="card-header">
                    <h3>${p.title}</h3>
                    <i data-lucide="maximize-2" class="card-icon"></i>
                </div>
                <div class="card-footer">
                    <span class="card-tag">${p.category}</span>
                    <p class="card-desc">${p.desc}</p>
                </div>
            </div>
        `;

    // Store State
    State.cards.push({
      id: p.id,
      el: card,
      data: p,
      x: x,
      y: y,
      rotation: randomRange(-12, 12),
      scale: 1
    });

    // Bind Events
    card.addEventListener('pointerdown', (e) => handleDragStart(e, p.id));
    card.addEventListener('click', (e) => {
      // If dragging, ignore click logic (handled by mouseup logic generally)
      // But we can check standard onclick if movement was small
    });

    container.appendChild(card);
  });

  lucide.createIcons(); // Refresh icons for new cards
}

function handleDragStart(e, id) {
  const cardObj = State.cards.find(c => c.id === id);
  if (!cardObj) return;

  State.draggingId = id;
  State.startPos = { x: e.clientX, y: e.clientY };
  State.cardStartPos = { x: cardObj.x, y: cardObj.y };
  State.maxZ++;

  const cardEl = cardObj.el;
  cardEl.style.zIndex = State.maxZ;
  cardEl.classList.add('dragging');

  // Flatten rotation while dragging
  cardEl.style.transform = `translate3d(${cardObj.x}px, ${cardObj.y}px, 0) rotate(0deg) scale(1.05)`;

  // Attach global listeners
  document.addEventListener('pointermove', handleDragMove);
  document.addEventListener('pointerup', handleDragEnd);
}

function handleDragMove(e) {
  if (!State.draggingId) return;

  const dx = e.clientX - State.startPos.x;
  const dy = e.clientY - State.startPos.y;

  const cardObj = State.cards.find(c => c.id === State.draggingId);
  const newX = State.cardStartPos.x + dx;
  const newY = State.cardStartPos.y + dy;

  // Update visual
  cardObj.el.style.transform = `translate3d(${newX}px, ${newY}px, 0) rotate(0deg) scale(1.05)`;

  // Collision Detection with Reader
  const readerRect = Elements.readerUnit.getBoundingClientRect();
  const cardRect = cardObj.el.getBoundingClientRect();
  const cardCX = cardRect.left + cardRect.width / 2;
  const cardCY = cardRect.top + cardRect.height / 2;

  // Simple bounds check with margin
  const hitMargin = 50;
  if (
    cardCX > readerRect.left - hitMargin &&
    cardCX < readerRect.right + hitMargin &&
    cardCY > readerRect.top - hitMargin &&
    cardCY < readerRect.bottom + hitMargin
  ) {
    if (!State.isOverReader) {
      State.isOverReader = true;
      Elements.readerUnit.classList.add('active');
      Elements.readerText.innerText = "DECODING...";
    }
  } else {
    if (State.isOverReader) {
      State.isOverReader = false;
      Elements.readerUnit.classList.remove('active');
      Elements.readerText.innerText = "INSERT CARD";
    }
  }
}

function handleDragEnd(e) {
  if (!State.draggingId) return;

  const cardObj = State.cards.find(c => c.id === State.draggingId);

  // Cleanup listeners
  document.removeEventListener('pointermove', handleDragMove);
  document.removeEventListener('pointerup', handleDragEnd);

  cardObj.el.classList.remove('dragging');

  // Logic: Drop or Reset
  if (State.isOverReader) {
    processDrop(cardObj);
  } else {
    // Just release at new position
    const dx = e.clientX - State.startPos.x;
    const dy = e.clientY - State.startPos.y;

    // If movement was tiny (<5px), treat as click -> open
    if (Math.abs(dx) < 5 && Math.abs(dy) < 5) {
      openProject(cardObj.data);
      // reset pos visual
      cardObj.el.style.transform = `translate3d(${State.cardStartPos.x}px, ${State.cardStartPos.y}px, 0) rotate(${cardObj.rotation}deg) scale(1)`;
      return;
    }

    cardObj.x = State.cardStartPos.x + dx;
    cardObj.y = State.cardStartPos.y + dy;
    cardObj.rotation = randomRange(-12, 12);

    cardObj.el.style.transform = `translate3d(${cardObj.x}px, ${cardObj.y}px, 0) rotate(${cardObj.rotation}deg) scale(1)`;
  }

  State.draggingId = null;
  State.isOverReader = false;
  Elements.readerUnit.classList.remove('active');
  Elements.readerText.innerText = "INSERT CARD";
}

function processDrop(cardObj) {
  // 1. Snap to reader center (Visually)
  const readerRect = Elements.readerUnit.getBoundingClientRect();
  const targetX = readerRect.left + readerRect.width / 2 - 150; // Center X - half card width
  const targetY = readerRect.top - 100;

  cardObj.el.style.transition = 'all 0.4s cubic-bezier(0.2, 0.8, 0.2, 1)';
  cardObj.el.style.transform = `translate3d(${targetX}px, ${targetY}px, 0) scale(0.9)`;
  cardObj.el.style.zIndex = 40; // Behind front plate logic managed by DOM order usually, but here just ensure specific layer

  // 2. Swallow Animation
  setTimeout(() => {
    cardObj.el.style.transform = `translate3d(${targetX}px, ${targetY + 150}px, 0) scale(0.8)`;
    cardObj.el.style.opacity = '0';
  }, 400);

  // 3. Trigger Modal & Reset
  setTimeout(() => {
    openProject(cardObj.data);

    // Reset card to random position
    const container = Elements.workDeck.getBoundingClientRect();
    cardObj.x = randomRange(50, container.width - 350);
    cardObj.y = randomRange(50, container.height / 2);

    // Remove transition for instant teleport
    cardObj.el.style.transition = 'none';
    cardObj.el.style.opacity = '1';
    cardObj.el.style.transform = `translate3d(${cardObj.x}px, ${cardObj.y}px, 0) rotate(${cardObj.rotation}deg) scale(1)`;

    // Restore transition logic for next hover (CSS handles it usually, or re-add class)
    setTimeout(() => cardObj.el.style.transition = '', 50);

  }, 1200);
}

// --- 3. UI MANAGERS ---

function openProject(data) {
  const m = Elements.modal;
  // Populate Data
  document.getElementById('modal-title').innerText = data.title;
  document.getElementById('modal-category').innerText = data.category;
  document.getElementById('modal-id').innerText = 'CASE #' + data.id.toUpperCase();
  document.getElementById('modal-desc').innerText = data.desc + " " + data.content;

  const visual = document.getElementById('modal-visual');
  visual.style.background = data.color;

  toggleModal(true);
}

function toggleModal(show) {
  if (show) {
    Elements.modal.classList.remove('hidden');
    Elements.modal.style.opacity = '1'; // Trigger CSS transition logic if needed
  } else {
    Elements.modal.classList.add('hidden');
  }
}

function toggleDrawer(show) {
  const drawer = Elements.drawer;
  if (show) {
    drawer.classList.remove('hidden');
    // Small delay to allow display:block to apply before transform
    requestAnimationFrame(() => drawer.classList.add('active'));
  } else {
    drawer.classList.remove('active');
    setTimeout(() => drawer.classList.add('hidden'), 500); // Wait for transition
  }
}

// --- UTILS ---
function randomRange(min, max) {
  return Math.random() * (max - min) + min;
}
